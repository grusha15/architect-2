# --- Supabase (real auth + database). Leave empty to run in demo mode. ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Model gateway (optional). Any one key makes plan generation real. ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional model id overrides
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_MODEL=gpt-5
GEMINI_MODEL=gemini-2.5-pro
